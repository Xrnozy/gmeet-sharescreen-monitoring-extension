{
  "manifest_version": 3,
  "name": "GMeet ShareMonitor",
  "version": "1.0",
  "description": "Monitor Google Meet screen-share video with pHash, dHash and SSIM combo.",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/hashUtils.js", "content/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
